[Unit]
Description=iotistic-telemetry service
After=network-online.target redis.service
Wants=network-online.target
Requires=redis.service


[Service]
Type=simple
ExecStart=/usr/bin/iotistic-telemetry
Restart=always
RestartSec=10
LimitNOFILE=10032
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target